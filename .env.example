# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# REQUIRED in production — every lead is POSTed here as JSON.
# Google Apps Script web-app URL, Make / Zapier "custom webhook" URL, or any CRM endpoint.
FORM_ENDPOINT=

# OPTIONAL — also e-mail each lead via Resend (https://resend.com).
RESEND_API_KEY=
LEAD_EMAIL_TO=sales@example.com,manager@example.com
LEAD_EMAIL_FROM="Ashok Heights Leads <leads@your-verified-domain.com>"

# OPTIONAL — analytics. Events are always pushed to window.dataLayer (for GTM).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
